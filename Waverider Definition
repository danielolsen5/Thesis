# Define properties of interest at each point in the flow for later callback
@dataclass
class Flowpoint:
    x: float
    y: float
    V: float
    theta: float
    p: float
    rho: float
    
    @property
    def a(self) -> float:
        return np.sqrt(gamma * self.p / self.rho)

    @property
    def M(self) -> float:
        return self.V / self.a

    @property
    def alpha(self) -> float:
        return np.arcsin(np.clip(1.0 / self.M, -1.0, 1.0))

    @property
    def T(self) -> float:
        return self.p / (self.rho * R) 
    
#------------------
# Thermo Relation
#------------------

def get_thermo(V: float, p: float, rho: float):
    a = np.sqrt(gamma * p / rho)
    M = V / a
    alpha = np.arcsin(np.clip(1.0/M, -1, 1))
    return a, M, alpha

#--------------------------------------------------
# Populate Initial Vlaue Line with Taylor Maccoll
#--------------------------------------------------

def initial_data(theta_ray: float):
    # radial and circumferential velocity
    u_r = V_o * (1.0 - 0.5 * theta_ray**2 + phi**2 * np.log(theta_ray / beta))
    v_theta = V_o * (-theta_ray + phi**2 / theta_ray)
    
    # combine velocity components
    V = np.hypot(u_r, v_theta)
    # Define streamline flow angle
    theta_flow = theta_ray + np.arctan2(v_theta, u_r)
    
    # Temperature and pressure distributions in shock layer
    T = T_o * (1.0 + 0.5 * (gamma - 1.0) * M_inf**2 * phi**2 * (
        2.0 - (phi / theta_ray)**2 - np.log((theta_ray / beta)**2)
    ))
    
    p = p_o * (1.0 + 0.5 * gamma * M_inf**2 * phi**2 * (
        2.0 + (phi / beta)**2 - (phi / theta_ray)**2 - np.log((theta_ray / beta)**2)
    ))
    
    rho = p / (R * T)
    return V, theta_flow, p, rho

# Define the initial data line inside of the shock connecting to the cone
def initialize_data_line(x_init: float = 0.5, num_pts: int = 20):

    theta_rays = np.linspace(phi, beta, num_pts)
    init_line = []
    for th_r in theta_rays:
        y_pt = x_init * np.tan(th_r)
        V, th_flow, p, rho = initial_data(th_r)
        init_line.append(Flowpoint(x=x_init, y=y_pt, V=V, theta=th_flow, p=p, rho=rho))
    return init_line




