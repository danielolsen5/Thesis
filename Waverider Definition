"""
Constants
"""
g = 9.81      # Gravitational acceleration
gamma = 1.4   # compressibility constant
R = 287       # Univeral gas constant (j/Kg*K)
L = -.0065    # temperature change with altitude (K\m)
 

"""
Free Stream Conditions Based on altitude    
"""
M_inf = 5                                         # Freestream Mach number
Alt = 15000                                       # Altitude (m)
T_o = 288.15 + (L*Alt)                            # Freestream temperature (K)
g = 9.81 * (1+ (Alt/6371000))**(-2)               # Gravitational Acceleration at altitude (m/s^2)
p_o = 101325 *(T_o/288.15)**(-g/(R*L))            # Freestream pressure (Pa)
rho_o = (p_o / (R * T_o))                         # Freestream density (kg/m^3)
a_o = np.sqrt(gamma * R * T_o)                    # Freestream speed of sound (m/s)
V_o = M_inf * a_o                                 # Freestream velocity (m/s)

