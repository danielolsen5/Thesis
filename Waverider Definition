    if Plot:
        def add_arrow(line, position=None, direction='right', size=.1, color=None):
            if color is None:
                color = line.get_color()

            # Extract line data and filter out trailing NaNs from RK4
            xdata = np.asarray(line.get_xdata(), dtype=float)
            ydata = np.asarray(line.get_ydata(), dtype=float)
            valid = ~(np.isnan(xdata) | np.isnan(ydata))
            xdata = xdata[valid]
            ydata = ydata[valid]

            if len(xdata) < 2:
                return  # Not enough valid points on the streamline to draw an arrow

            if position is None:
                positions = [xdata.mean()]
            elif np.ndim(position) == 0:
                positions = [position]
            else:
                positions = position

            for pos in positions:
                # Skip if the requested x-position is outside this streamline's valid range
                if not (xdata.min() <= pos <= xdata.max()):
                    continue

                # Find closest index 
                start_ind = int(np.argmin(np.abs(xdata - pos)))
                if direction == 'right':
                    start_ind = min(start_ind, len(xdata) - 2)
                    end_ind = start_ind + 1
                else:
                    start_ind = max(start_ind, 1)
                    end_ind = start_ind - 1

                line.axes.annotate(
                    '',
                    xytext=(xdata[start_ind], ydata[start_ind]),
                    xy=(xdata[end_ind], ydata[end_ind]),
                    arrowprops=dict(arrowstyle="-|>", color=color, lw=1),
                    size=size
                )

        fig, ax = plt.subplots(figsize=(10, 5))

        # Trace streamlines from x = -0.5 across a range of starting heights y_seed
        y_seeds = np.linspace(0.08, y_end * 0.9, 6)
        for idx, y_seed in enumerate(y_seeds):
            sl = calculate_single_streamline_rk4(x_start, y_seed, h_stream, n_steps, x_vals, y_vals, u, v)
            label = 'RK4 Streamlines' if idx == 0 else None
            
            # Capture the Line2D handle [0] from ax.plot
            line = ax.plot(sl[:, 0], sl[:, 1], color='black', lw=1.2, label=label)[0]
            
            # Add arrows at points
            add_arrow(line, position=[0, 1.25, 2.5, 3.75, 4.75], direction='right', size=14, color='black')

        # Plot the geometry
        ax.plot(x_geom, y_cone, 'k-', lw=1.5, label='Cone Surface')
        ax.plot(x_geom, y_shock, 'k--', lw=1, label='Shock Wave')
        ax.add_collection(
        LineCollection(hatches, colors="black", linewidths=hatch_lw))

        ax.set_xlim(x_start, x_end)
        ax.set_ylim(y_start, y_end * 1.05)
        ax.set_title(f'Streamlines ($M_\\infty$ = {M_inf}, $\\phi$ = {np.degrees(phi)}$^\\circ$)')
